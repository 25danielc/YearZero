// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  resolutions   Resolution[]
  checkIns      CheckIn[]
  graceTokens   GraceToken[]
  badges        Badge[]
  levelProgress LevelProgress?
}

model Resolution {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  category      String // HEALTH, FITNESS, LEARNING, PRODUCTIVITY, RELATIONSHIPS, FINANCIAL, CREATIVE, MINDFULNESS, OTHER
  frequencyType String // DAILY, WEEKLY
  targetPerPeriod Int
  startDate     DateTime
  isArchived    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  checkIns      CheckIn[]

  @@index([userId])
  @@index([userId, isArchived])
}

model CheckIn {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resolutionId String
  resolution  Resolution     @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  date        String         // YYYY-MM-DD format
  status      String // DONE, PARTIAL, MISSED
  note        String?
  xpAwarded   Int            @default(0)
  createdAt   DateTime       @default(now())

  @@unique([userId, resolutionId, date])
  @@index([userId, date])
  @@index([resolutionId, date])
}

model GraceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String   // YYYY-MM format
  usedCount Int      @default(0)

  @@unique([userId, month])
  @@index([userId])
}

model Badge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // FIRST_CHECKIN, STREAK_7_DAYS, COMEBACK, XP_100, STREAK_30_DAYS
  earnedAt  DateTime  @default(now())

  @@unique([userId, type])
  @@index([userId])
}

model LevelProgress {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp   Int      @default(0)
  level     Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt
}

